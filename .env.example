# FearNot Research - Environment Variables
# Copy this file to .env and fill in your own API keys.
# Never commit .env to git (it is in .gitignore).

# Claude API (Anthropic)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# FRED (Federal Reserve Economic Data) - Free
# Get yours at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-key-here

# EIA (US Energy Information Administration) - Free
# Get yours at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your-eia-key-here

# NewsAPI - Free tier available
# Get yours at: https://newsapi.org/register
NEWS_API_KEY=your-newsapi-key-here
